---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 · justin.vc" description="no such file or directory" noindex={true}>
  <div class="wrap">
    <nav class="crumb">
      <a href="/">~/</a>
      <span class="sep">/</span>
      <span class="here">404</span>
    </nav>

    <div class="shell">
      <span class="dot np-idle"></span>
      <span class="prompt">justin@justin.vc:~$</span>
      <span class="path" id="nf-cmd">cat</span>
    </div>

    <h1 class="nf-line">cat: no such file or directory</h1>
    <p class="nf-hint">// the path you asked for is not here. try <a href="/">~/</a>, or press <kbd>/</kbd> for the command palette.</p>
  </div>

  <script is:inline>
    // Echo the requested path back in the prompt so the page reads like the
    // shell response it is pretending to be.
    (function () {
      var el = document.getElementById('nf-cmd');
      if (!el) return;
      var p = (location.pathname || '/').replace(/^\/+/, '').slice(0, 64);
      el.textContent = 'cat ' + (p || '?');
    })();
  </script>
</BaseLayout>

<style>
  .crumb {
    font-size: 0.78rem; color: var(--fg-mute);
    border-bottom: 1px solid var(--rule-dim);
    padding-bottom: 0.75rem; margin-bottom: 2rem;
    display: flex; gap: 0.4rem; align-items: baseline;
  }
  .crumb a { color: var(--link); text-decoration: none; }
  .crumb a:hover { color: var(--hot); }
  .crumb .sep { color: var(--fg-dim); }
  .crumb .here { color: var(--fg); }
  .nf-line { font-size: 1rem; font-weight: 600; color: var(--accent); margin: 1.5rem 0 0.75rem; letter-spacing: 0.02em; }
  .nf-hint { font-size: 0.85rem; color: var(--fg-dim); max-width: 46ch; line-height: 1.55; }
  .nf-hint a { color: var(--link); text-decoration: none; }
  .nf-hint a:hover { color: var(--hot); }
  .nf-hint kbd { border: 1px solid var(--rule-dim); padding: 0 0.3rem; }
</style>
