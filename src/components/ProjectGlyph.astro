---
/*
 * Procedural Earthbound-ish badge for a project row: concentric rings, nested
 * diamonds, starbursts, spirals, polar checkers, halftones, zigzags, lattices.
 *
 * `shape` is chosen list-wide by assignGlyphs() so no two rows repeat a figure;
 * everything else (how many bands, which way it is rotated) comes from a hash
 * of the name, so a project keeps its exact badge across builds. It all
 * resolves at build time into inline SVG — no runtime cost, no layout shift.
 *
 * Nothing here knows a colour. Every stroke and fill is currentColor, so the
 * badge takes its tone from the surrounding element and follows the theme.
 */
import { hash } from '../glyph';

interface Props {
  seed: string;
  shape: number;
}
const { seed, shape } = Astro.props;

const h = hash(seed);
const variant = (h >>> 8) & 0xff;
const spin = (h >>> 16) & 0xff;

const C = 20;
const R = 17;
const n = (v: number) => v.toFixed(2);
const clipId = `g${h.toString(36)}`;

const px = (a: number, r: number) => C + r * Math.cos(a);
const py = (a: number, r: number) => C + r * Math.sin(a);

function rings(count: number): string[] {
  return Array.from({ length: count }, (_, i) => {
    const r = ((i + 1) / count) * R;
    return `<circle cx="${C}" cy="${C}" r="${n(r)}" fill="none" stroke-width="${i % 2 ? 2.2 : 0.9}"/>`;
  });
}

function diamonds(count: number): string[] {
  return Array.from({ length: count }, (_, i) => {
    const r = ((i + 1) / count) * R;
    const pts = [[C, C - r], [C + r, C], [C, C + r], [C - r, C]]
      .map(([x, y]) => `${n(x)},${n(y)}`)
      .join(' ');
    return `<polygon points="${pts}" fill="none" stroke-width="${i % 2 ? 1.9 : 0.9}"/>`;
  });
}

function rays(count: number): string[] {
  const step = (Math.PI * 2) / count;
  const out = Array.from({ length: count }, (_, i) => {
    const a = i * step;
    return `<line x1="${n(px(a, 4))}" y1="${n(py(a, 4))}" x2="${n(px(a, R))}" y2="${n(py(a, R))}" stroke-width="1.5"/>`;
  });
  out.push(`<circle cx="${C}" cy="${C}" r="3" fill="currentColor" stroke="none"/>`);
  return out;
}

function spiral(turns: number): string[] {
  const steps = turns * 36;
  let d = '';
  for (let i = 0; i <= steps; i++) {
    const t = (i / steps) * turns * Math.PI * 2;
    const r = (i / steps) * R;
    d += `${i ? 'L' : 'M'}${n(px(t, r))} ${n(py(t, r))}`;
  }
  return [`<path d="${d}" fill="none" stroke-width="1.4"/>`];
}

function checker(count: number): string[] {
  const step = (Math.PI * 2) / count;
  const out: string[] = [];
  for (let i = 0; i < count; i += 2) {
    const a0 = i * step;
    const a1 = a0 + step;
    out.push(
      `<path d="M${C} ${C} L${n(px(a0, R))} ${n(py(a0, R))} A${R} ${R} 0 0 1 ${n(px(a1, R))} ${n(py(a1, R))} Z" fill="currentColor" stroke="none"/>`,
    );
  }
  out.push(`<circle cx="${C}" cy="${C}" r="${n(R * 0.52)}" fill="none" stroke-width="1.6"/>`);
  return out;
}

function halftone(): string[] {
  const out: string[] = [];
  for (let y = 5.5; y <= 34.5; y += 5.8) {
    for (let x = 5.5; x <= 34.5; x += 5.8) {
      const d = Math.hypot(x - C, y - C);
      if (d > R) continue;
      // Dots swell toward the middle, the way a halftone gradient does.
      out.push(`<circle cx="${n(x)}" cy="${n(y)}" r="${n(2.6 * (1 - d / R) + 0.6)}" fill="currentColor" stroke="none"/>`);
    }
  }
  return out;
}

function zigzag(count: number): string[] {
  const out: string[] = [];
  const w = 4.5;
  for (let i = 0; i < count; i++) {
    const y = 4 + (i * 32) / (count - 1);
    let d = `M0 ${n(y)}`;
    for (let x = 0, up = true; x < 40; x += w, up = !up) {
      d += `L${n(x + w)} ${n(up ? y - 3 : y + 3)}`;
    }
    out.push(`<path d="${d}" fill="none" stroke-width="1.3"/>`);
  }
  return out;
}

function lattice(count: number): string[] {
  const out: string[] = [];
  const step = 40 / count;
  for (let i = -count; i <= count * 2; i++) {
    const o = i * step;
    out.push(`<line x1="${n(o)}" y1="0" x2="${n(o + 40)}" y2="40" stroke-width="1.2"/>`);
    out.push(`<line x1="${n(o)}" y1="40" x2="${n(o + 40)}" y2="0" stroke-width="1.2"/>`);
  }
  return out;
}

// Order must match SHAPE_COUNT in ../glyph. `clip` marks the figures drawn
// across the whole tile, which get cut back to the badge circle.
const SHAPES: Array<{ build: () => string[]; clip: boolean }> = [
  { build: () => rings(3 + (variant % 3)), clip: false },
  { build: () => diamonds(3 + (variant % 3)), clip: false },
  { build: () => rays(8 + (variant % 5) * 2), clip: false },
  { build: () => spiral(3 + (variant % 2)), clip: false },
  { build: () => checker(8 + (variant % 3) * 2), clip: false },
  { build: () => halftone(), clip: false },
  { build: () => zigzag(5 + (variant % 3)), clip: true },
  { build: () => lattice(4 + (variant % 3)), clip: true },
];

const chosen = SHAPES[shape % SHAPES.length];
const rot = (spin / 256) * 90 - 45;
const body = chosen.build().join('');
const svg =
  '<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"' +
  ' stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">' +
  (chosen.clip ? `<defs><clipPath id="${clipId}"><circle cx="${C}" cy="${C}" r="${R}"/></clipPath></defs>` : '') +
  `<g transform="rotate(${n(rot)} ${C} ${C})">` +
  (chosen.clip ? `<g clip-path="url(#${clipId})">${body}</g>` : body) +
  '</g></svg>';
---
<Fragment set:html={svg} />
